PORT=

MONGO_URI=

JWT_SECRET=

# Deployed frontend origin, e.g. https://your-app.vercel.app
# When set, CORS is restricted to this origin. Leave blank for local dev.
CLIENT_URL=

# Public API base URL shown in Swagger docs, e.g. https://your-api.onrender.com/api
# Leave blank for local dev (defaults to http://localhost:5000/api).
API_URL=
